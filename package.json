{
  "name": "dsh-ledger",
  "version": "0.1.0",
  "description": "Chat-first ledger plugin for DeepSeek Harness: one sentence in, verified money out — home spending plus a small shop's cash flow and receivables.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/**",
    "skills/**",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "test": "node --test 'test/**/*.test.js'",
    "test:watch": "node --test --watch 'test/**/*.test.js'"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["deepseek-harness", "dsh", "cordis", "plugin", "ledger", "bookkeeping", "wechat"],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  }
}
